{
  "name": "task-tracker",
  "version": "0.1.0",
  "description": "A local macOS task tracker backed by DailyTracker.xlsx.",
  "author": "Paul Moldovan",
  "private": true,
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on tcp:5173 && npm run build:main && electron .\"",
    "dev:debug": "OPEN_DEVTOOLS=true npm run dev",
    "build": "npm run typecheck && npm run test && npm run build:main && vite build",
    "build:main": "tsc -p tsconfig.main.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dist:mac": "npm run build && electron-builder --mac"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.4.8",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^10.0.3",
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^29.1.1",
    "typescript": "^5.7.2",
    "vite": "^8.1.3",
    "vitest": "^4.1.9",
    "wait-on": "^9.0.10"
  },
  "overrides": {
    "uuid": "^11.1.1"
  },
  "build": {
    "appId": "com.local.tasktracker",
    "productName": "Task Tracker",
    "icon": "build/icon.png",
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "identity": null,
      "target": [
        "dmg",
        "zip"
      ]
    }
  }
}
